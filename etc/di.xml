<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
	<!-- Add fields to Order API response -->
	<type name="Magento\Sales\Api\OrderRepositoryInterface">
		<plugin name="ecinternet_base-sales_api_orderrepositoryinterface"
		        type="ECInternet\Base\Plugin\Sales\Api\OrderRepositoryInterfacePlugin" />
	</type>

	<!-- Override sales_order_grid collection to join customer_number from EAV -->
	<!-- This must be defined in etc/di.xml, and not adminhtml to avoid overriding the whole collection map -->
	<type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
		<arguments>
			<argument name="collections" xsi:type="array">
				<item name="sales_order_grid_data_source" xsi:type="string">ECInternet\Base\Model\ResourceModel\Order\Grid\Collection</item>
			</argument>
		</arguments>
	</type>

	<!-- Custom Logger -->
	<type name="ECInternet\Base\Logger\Logger">
		<arguments>
			<argument name="name" xsi:type="string">Base</argument>
			<argument name="handlers" xsi:type="array">
				<item name="system" xsi:type="object">ECInternet\Base\Logger\Handler</item>
			</argument>
		</arguments>
	</type>
</config>
